<!-- miniprogram/admin/pages/auth-review-detail/auth-review-detail.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">审核详情</text>
  </view>

  <block wx:if="{{!isLoading}}">
    <scroll-view class="content" scroll-y="true">
      <!-- Section: Applicant Info -->
      <view class="section">
        <view class="section-title">申请人信息</view>
        <view class="info-card">
          <image class="avatar" src="{{authDetail.userInfo.avatarUrl}}" mode="aspectFill"></image>
          <view class="user-info">
            <text class="nickname">{{authDetail.userInfo.nickName}}</text>
            <text class="join-time">加入时间: {{authDetail.userInfo.formattedJoinDate}}</text>
          </view>
        </view>
      </view>

      <!-- Section: Auth Details -->
      <view class="section">
        <view class="section-title">认证资料 ({{authDetail.typeText}})</view>
        <view class="details-card">
          <!-- Dynamically render details based on auth type -->
          <block wx:if="{{authDetail.type === 'realName'}}">
            <view class="detail-item"><text class="label">姓名:</text> <text class="value">{{authDetail.data.realName}}</text></view>
            <view class="detail-item"><text class="label">身份证号:</text> <text class="value">{{authDetail.data.idCardNumber}}</text></view>
            <view class="detail-item image-item">
              <text class="label">手持身份证照片:</text>
              <image class="preview-image" src="{{authDetail.data.idCardImageUrl}}" mode="widthFix" bindtap="previewImage" data-src="{{authDetail.data.idCardImageUrl}}"></image>
            </view>
          </block>

          <block wx:if="{{authDetail.type === 'enterprise'}}">
             <!-- Enterprise auth fields here -->
          </block>

          <block wx:if="{{authDetail.type === 'pilot'}}">
             <!-- Pilot auth fields here -->
          </block>
        </view>
      </view>
    </scroll-view>

    <!-- Footer Action Buttons -->
    <view class="footer">
      <button class="action-button reject" bindtap="onReject">拒绝</button>
      <button class="action-button approve" bindtap="onApprove">批准</button>
    </view>
  </block>

  <view class="loading-state" wx:else>
    <text>加载中...</text>
  </view>
</view>
