/* miniprogram/components/list-card/list-card.wxss */
.card {
  background-color: #ffffff;
  border-radius: 0.75rem;
  padding: 1rem;
  margin-bottom: 1rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
.card:active {
    background-color: #f9fafb;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}
.title {
  font-size: 1.125rem;
  font-weight: bold;
  color: #111827;
  flex: 1;
  margin-right: 1rem;
}
.reward {
  font-size: 1.25rem;
  font-weight: bold;
  color: #136dec;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 0.75rem;
}
.tag-status, .tag-category {
  padding: 0.25rem 0.625rem;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: 9999px;
}
.tag-status { color: #166534; background-color: #dcfce7; }
.tag-status.status-in_progress { color: #c2410c; background-color: #fff7ed; }
.tag-status.status-pending_payment { color: #c2410c; background-color: #fff7ed; }
.tag-status.status-completed { color: #166534; background-color: #dcfce7; }
.tag-status.status-cancelled { color: #4b5563; background-color: #f3f4f6; }
.tag-category { color: #4b5563; background-color: #f3f4f6; }

.divider {
  height: 1px;
  background-color: #f3f4f6;
  margin: 1rem 0;
}

.info-section {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.info-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
  color: #6b7280;
}
.info-item .material-symbols-outlined { font-size: 1rem; }

.footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid #f3f4f6;
}
.action-button {
  height: 2.25rem;
  padding: 0 1.25rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: bold;
  margin-left: 0.5rem;
}
.action-button.primary {
    background-color: #136dec;
    color: #ffffff;
}
.action-button.secondary {
    background-color: #f3f4f6;
    color: #4b5563;
}
