/* miniprogram/components/list-card/list-card.wxss */
.card {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.dark .card {
    background-color: #1a242f;
}


.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.title {
  font-size: 16px;
  font-weight: bold;
  color: #303133;
  flex: 1;
  margin-right: 12px;
}

.dark .title {
    color: #f0f0f0;
}


.reward {
  font-size: 18px;
  font-weight: bold;
  color: #fa8c16;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag-status {
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 500;
}

.status-open, .status-recruiting {
  background-color: rgba(34, 197, 94, 0.1);
  color: #22c55e;
}
.status-in_progress, .status-pending_confirmation {
  background-color: rgba(59, 130, 246, 0.1);
  color: #3b82f6;
}
.status-completed {
  background-color: rgba(107, 114, 128, 0.1);
  color: #6b7280;
}
.status-cancelled {
    background-color: rgba(156, 163, 175, 0.1);
    color: #9ca3af;
}

.tag-category {
  padding: 4px 8px;
  border-radius: 4px;
  font-size: 12px;
  background-color: #f4f4f5;
  color: #909399;
}

.dark .tag-category {
    background-color: #2c3542;
    color: #a0a0a0;
}


.divider {
  height: 1px;
  background-color: #e5e7eb;
  margin: 4px 0;
}

.dark .divider {
    background-color: #374151;
}

.info-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  color: #606266;
}

.dark .info-item {
    color: #a0a0a0;
}


.info-item .material-symbols-outlined {
  font-size: 16px;
}

.footer {
    border-top: 1px solid #e5e7eb;
    padding-top: 12px;
    margin-top: 4px;
    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.dark .footer {
    border-top-color: #374151;
}

.action-button {
    padding: 6px 16px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    border: 1px solid #dcdfe6;
    background-color: #ffffff;
    color: #606266;
}

.dark .action-button {
    background-color: #2c3542;
    border-color: #4b5563;
    color: #f0f0f0;
}


.action-button.primary {
    background-color: #136dec;
    border-color: #136dec;
    color: #ffffff;
}
