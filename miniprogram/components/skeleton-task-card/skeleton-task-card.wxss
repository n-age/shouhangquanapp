/* miniprogram/components/skeleton-task-card/skeleton-task-card.wxss */
@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: -100% 50%; }
}

.skeleton-card {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.dark .skeleton-card {
    background-color: #1a242f;
}

.skeleton-line {
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: skeleton-loading 1.5s infinite;
  border-radius: 4px;
}

.dark .skeleton-line {
    background: linear-gradient(90deg, #2c3542 25%, #374151 50%, #2c3542 75%);
    background-size: 200% 100%;
}

.skeleton-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.skeleton-line.title {
  width: 60%;
  height: 20px;
}

.skeleton-line.reward {
  width: 20%;
  height: 24px;
}

.skeleton-tags {
  display: flex;
  gap: 8px;
  margin-bottom: 16px;
}

.skeleton-line.tag {
  width: 25%;
  height: 24px;
}

.skeleton-info .info-line {
  width: 80%;
  height: 16px;
  margin-bottom: 8px;
}

.skeleton-info .info-line:last-child {
  width: 50%;
}
