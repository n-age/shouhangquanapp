/* miniprogram/components/skeleton-task-card/skeleton-task-card.wxss */
.skeleton-card {
  background-color: #ffffff;
  border-radius: 0.75rem;
  padding: 1rem;
  margin-bottom: 1rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.skeleton-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.skeleton-title {
  width: 70%;
  height: 24px;
  background-color: #f3f4f6;
}

.skeleton-reward {
  width: 20%;
  height: 28px;
  background-color: #f3f4f6;
}

.skeleton-tags {
  display: flex;
  gap: 0.5rem;
  margin-top: 0.75rem;
}

.skeleton-tag {
  width: 25%;
  height: 20px;
  background-color: #f3f4f6;
  border-radius: 9999px;
}

.skeleton-divider {
  height: 1px;
  background-color: #f3f4f6;
  margin: 1rem 0;
}

.skeleton-info {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.skeleton-info-item {
  width: 50%;
  height: 16px;
  background-color: #f3f4f6;
}
.skeleton-info-item:last-child {
  width: 40%;
}

.skeleton-animate {
  background-image: linear-gradient(90deg, #f3f4f6 25%, #e5e7eb 37%, #f3f4f6 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
}

@keyframes skeleton-loading {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0 50%;
  }
}
