<!-- miniprogram/pages/auth-enterprise/auth-enterprise.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">企业认证</text>
  </view>

  <view class="content">
    <!-- Enterprise Name Field -->
    <view class="form-group">
      <label class="label" for="enterprise-name">企业名称</label>
      <input id="enterprise-name" class="input" placeholder="请输入营业执照上的企业全称" bindinput="onInput" data-field="enterpriseName" />
    </view>

    <!-- Social Credit Code Field -->
    <view class="form-group">
      <label class="label" for="credit-code">统一社会信用代码</label>
      <input id="credit-code" class="input" placeholder="请输入18位统一社会信用代码" bindinput="onInput" data-field="creditCode" />
    </view>

    <!-- Business License Upload -->
    <view class="form-group">
      <label class="label">营业执照</label>
      <view class="image-uploader" bindtap="chooseImage">
        <block wx:if="!licenseImageUrl">
          <view class="upload-icon-container">
            <text class="material-symbols-outlined">add_photo_alternate</text>
          </view>
          <view class="upload-text-container">
            <text class="upload-title">点击上传营业执照照片</text>
            <text class="upload-subtitle">请确保照片清晰可见</text>
          </view>
        </block>
        <block wx:else>
          <image class="preview-image" src="{{licenseImageUrl}}" mode="aspectFit"></image>
        </block>
      </view>
    </view>
  </view>

  <!-- Footer Action Button -->
  <view class="footer">
    <button class="submit-button" bindtap="submit" disabled="{{!canSubmit}}">提交审核</button>
    <text class="footer-text">我们承诺保护您的信息安全</text>
  </view>
</view>
