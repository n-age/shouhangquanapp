/* miniprogram/pages/auth-enterprise/auth-enterprise.wxss */
@import "/styles/common.wxss";

page {
  background-color: #101822;
  color: #f0f0f0;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.header {
  display: flex; align-items: center; padding: 1rem;
  background-color: #101822;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: sticky; top: 0; z-index: 100;
}
.back-button {
  display: flex; align-items: center; justify-content: center;
  width: 2.5rem; height: 2.5rem; margin-left: -0.5rem;
}
.title {
  flex: 1; text-align: center; font-size: 1.125rem;
  font-weight: bold; margin-right: 2.5rem;
}

.content {
  flex: 1;
  padding: 1.5rem 1rem;
}

.form-group {
  margin-bottom: 1.5rem;
}
.label {
  font-size: 1rem;
  font-weight: 500;
  color: #e5e7eb;
  margin-bottom: 0.75rem;
  display: block;
}
.input {
  width: 100%;
  height: 3.5rem;
  padding: 0 1rem;
  background-color: #18222c;
  border: 1px solid #374151;
  border-radius: 0.5rem;
  font-size: 1rem;
  color: #f0f0f0;
  box-sizing: border-box;
}
.input::placeholder {
  color: #6b7280;
}

.image-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1rem;
  border: 2px dashed #374151;
  border-radius: 0.75rem;
  padding: 2.5rem 1.5rem;
  cursor: pointer;
  transition: border-color 0.2s;
}
.image-uploader:hover {
  border-color: #136dec;
}
.upload-icon-container {
  width: 3rem;
  height: 3rem;
  border-radius: 9999px;
  background-color: rgba(19, 109, 236, 0.2);
  color: #60a5fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.75rem;
}
.upload-text-container {
  text-align: center;
}
.upload-title {
  font-size: 1rem;
  font-weight: 500;
}
.upload-subtitle {
  font-size: 0.875rem;
  color: #a0a0a0;
  margin-top: 0.25rem;
}
.preview-image {
  max-width: 100%;
  max-height: 200px;
  border-radius: 0.5rem;
}

.footer {
  position: sticky; bottom: 0; padding: 1rem;
  background: rgba(16, 24, 34, 0.8);
  backdrop-filter: blur(5px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}
.submit-button {
  width: 100%; height: 3.5rem; border-radius: 0.75rem;
  background-color: #136dec; color: #ffffff;
  font-size: 1.125rem; font-weight: bold;
}
.submit-button[disabled] {
  background-color: #374151;
  color: #9ca3af;
}
.footer-text {
  display: block;
  text-align: center;
  font-size: 0.75rem;
  color: #a0a0a0;
  padding-top: 0.75rem;
}
