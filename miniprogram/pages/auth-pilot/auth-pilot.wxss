/* miniprogram/pages/auth-pilot/auth-pilot.wxss */
@import "/styles/common.wxss";

page {
  background-color: #101822;
  color: #f0f0f0;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

.header {
  display: flex; align-items: center; padding: 1rem;
  background-color: #101822;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: sticky; top: 0; z-index: 100;
}
.back-button {
  display: flex; align-items: center; justify-content: center;
  width: 2.5rem; height: 2.5rem; margin-left: -0.5rem;
}
.title {
  flex: 1; text-align: center; font-size: 1.125rem;
  font-weight: bold; margin-right: 2.5rem;
}

.content {
  flex: 1;
  padding: 1rem 1.5rem;
}

.description {
  font-size: 0.9375rem;
  color: #a0a0a0;
  margin-bottom: 2rem;
}

.form-group {
  margin-bottom: 1.5rem;
}
.label {
  font-size: 1rem;
  font-weight: 500;
  color: #e5e7eb;
  margin-bottom: 0.75rem;
  display: block;
}
.input, .picker {
  width: 100%;
  height: 3.5rem;
  padding: 0 1rem;
  background-color: #18222c;
  border: 1px solid #374151;
  border-radius: 0.5rem;
  font-size: 1rem;
  color: #f0f0f0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}
.picker {
  justify-content: space-between;
}
.picker-text {
  flex: 1;
}

.image-uploader {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 1rem; border: 2px dashed #374151; border-radius: 0.75rem;
  padding: 2rem; text-align: center;
}
.upload-icon-container {
  width: 3.5rem; height: 3.5rem; border-radius: 9999px;
  background-color: rgba(19, 109, 236, 0.2); color: #60a5fa;
  display: flex; align-items: center; justify-content: center;
  font-size: 2rem;
}
.upload-title { font-weight: 500; }
.upload-subtitle { font-size: 0.875rem; color: #a0a0a0; margin-top: 0.25rem; }
.preview-image { max-width: 100%; max-height: 150px; border-radius: 0.5rem; }

.footer {
  position: sticky; bottom: 0; padding: 1rem;
  background: rgba(16, 24, 34, 0.8); backdrop-filter: blur(5px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}
.submit-button {
  width: 100%; height: 3.5rem; border-radius: 0.75rem;
  background-color: #136dec; color: #ffffff;
  font-size: 1.125rem; font-weight: bold;
}
.submit-button[disabled] {
  background-color: #374151; color: #9ca3af;
}
