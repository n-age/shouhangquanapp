<!--miniprogram/pages/auth-pilot/index.wxml-->
<view class="container">
  <view class="form-card">
    <view class="form-title">飞手认证</view>

    <view class="form-group">
      <text class="form-label">无人机型号</text>
      <input class="form-input" placeholder="请输入您的无人机型号" bindinput="handleInput" data-field="droneModel" value="{{formData.droneModel}}"/>
    </view>

    <view class="form-group">
      <text class="form-label">飞手经验 (年)</text>
      <input class="form-input" type="number" placeholder="请输入您的飞行经验年限" bindinput="handleInput" data-field="experience" value="{{formData.experience}}"/>
    </view>

    <view class="form-group">
      <text class="form-label">上传飞手执照</text>
      <view class="uploader-container">
        <view class="uploader-item" bindtap="uploadLicense">
          <image class="uploader-image" wx:if="{{licenseUrl}}" src="{{licenseUrl}}" mode="aspectFill"/>
          <text wx:else>点击上传您的执照</text>
        </view>
      </view>
    </view>
  </view>

  <button class="submit-button" type="primary" bindtap="handleSubmit">提交认证</button>
</view>
