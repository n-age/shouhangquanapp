<!-- miniprogram/pages/auth-real-name/auth-real-name.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">实名认证</text>
  </view>

  <!-- Page Indicators -->
  <view class="page-indicators">
    <view class="indicator"></view>
    <view class="indicator active"></view>
    <view class="indicator"></view>
  </view>

  <!-- Body Text -->
  <view class="intro-text-container">
    <text class="intro-text">根据平台规定，为保障服务安全，请完成实名认证</text>
  </view>

  <view class="form-container">
    <!-- Section Header -->
    <text class="section-title">身份信息</text>

    <!-- Text Field: Full Name -->
    <view class="input-group">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入您的真实姓名" bindinput="onInput" data-field="realName" />
      <text class="helper-text">请确保姓名与身份证一致</text>
    </view>

    <!-- Text Field: ID Number -->
    <view class="input-group">
      <text class="label">身份证号</text>
      <input class="input" placeholder="请输入您的身份证号码" bindinput="onInput" data-field="idCardNumber" />
    </view>

    <!-- Section Header: Photo Upload -->
    <text class="section-title photo-title">手持身份证照片</text>

    <!-- Image Uploader -->
    <view class="image-uploader" bindtap="chooseImage">
      <block wx:if="{{!idCardImageUrl}}">
        <text class="material-symbols-outlined upload-icon">add_a_photo</text>
        <text class="upload-text">点击上传手持身份证照片</text>
        <view class="upload-subtext">
          <text>请确保照片清晰、完整，</text>
          <text class="example-link">查看示例</text>
        </view>
      </block>
      <block wx:else>
        <image class="preview-image" src="{{idCardImageUrl}}" mode="aspectFill"></image>
      </block>
    </view>
  </view>

  <!-- Fixed Bottom Section -->
  <view class="footer">
    <button class="submit-button" bindtap="submit" disabled="{{!canSubmit}}">提交审核</button>
    <text class="footer-text">我们承诺保障您的信息安全</text>
  </view>
</view>
