/* miniprogram/pages/auth-real-name/auth-real-name.wxss */
@import "/styles/common.wxss";

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #ffffff;
  color: #111418;
}

.header {
  display: flex;
  align-items: center;
  padding: 1rem;
  padding-bottom: 0.5rem;
  position: sticky;
  top: 0;
  background-color: #ffffff;
  z-index: 10;
}

.back-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 1.125rem;
  font-weight: bold;
  margin-right: 2.5rem; /* to balance the back button */
}

.page-indicators {
  display: flex;
  justify-content: center;
  gap: 0.75rem;
  padding: 0.75rem 0;
}

.indicator {
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 9999px;
  background-color: #d1d5db;
}

.indicator.active {
  background-color: #136dec;
}

.intro-text-container {
  padding: 0.25rem 1rem 1rem;
}

.intro-text {
  font-size: 0.875rem;
  color: #6b7280;
}

.form-container {
  display: flex;
  flex-direction: column;
  padding: 0 1rem;
  padding-bottom: 8rem; /* Space for fixed footer */
}

.section-title {
  font-size: 1.125rem;
  font-weight: bold;
  padding-top: 1rem;
  padding-bottom: 0.5rem;
}

.photo-title {
  padding-top: 1.5rem;
}

.input-group {
  padding: 0.75rem 0;
}

.label {
  display: block;
  font-size: 1rem;
  font-weight: 500;
  margin-bottom: 0.5rem;
}

.input {
  width: 100%;
  height: 3.5rem;
  padding: 0 1rem;
  border: 1px solid #e5e7eb;
  background-color: #ffffff;
  border-radius: 0.5rem;
  font-size: 1rem;
  box-sizing: border-box;
}

.input:focus {
  border-color: #136dec;
  box-shadow: 0 0 0 2px rgba(19, 109, 236, 0.2);
}

.helper-text {
  display: block;
  font-size: 0.75rem;
  color: #6b7280;
  margin-top: 0.375rem;
}

.image-uploader {
  margin-top: 0.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2px dashed #d1d5db;
  border-radius: 0.5rem;
  padding: 2rem 1.5rem;
  text-align: center;
}

.upload-icon {
  font-size: 3rem;
  color: #9ca3af;
}

.upload-text {
  margin-top: 0.5rem;
  font-size: 0.875rem;
  color: #4b5563;
}

.upload-subtext {
  margin-top: 0.25rem;
  font-size: 0.75rem;
  color: #6b7280;
}

.example-link {
  color: #136dec;
  font-weight: 500;
}

.preview-image {
  width: 100%;
  height: 100%;
  border-radius: 0.5rem;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 1rem;
  padding-top: 0.75rem;
  border-top: 1px solid #e5e7eb;
}

.submit-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 3rem;
  border-radius: 0.5rem;
  background-color: #136dec;
  color: #ffffff;
  font-size: 1rem;
  font-weight: bold;
}

.submit-button[disabled] {
  background-color: #d1d5db;
  cursor: not-allowed;
}

.footer-text {
  display: block;
  text-align: center;
  font-size: 0.75rem;
  color: #6b7280;
  padding-top: 0.75rem;
}
