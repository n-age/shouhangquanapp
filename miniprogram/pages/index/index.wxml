<!--miniprogram/pages/index/index.wxml-->
<view class="container">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索任务/飞手" />
  </view>

  <!-- 功能分类 -->
  <view class="category-grid">
    <view class="category-item" wx:for="{{categories}}" wx:key="text">
      <view class="category-icon"></view>
      <text class="category-text">{{item.text}}</text>
    </view>
  </view>

  <!-- 新闻资讯 -->
  <view class="news-section">
    <text class="section-title">新闻资讯</text>
    <view class="news-item" wx:for="{{news}}" wx:key="text">
      <text class="news-text">{{item.text}}</text>
    </view>
  </view>

  <!-- 任务推荐 -->
  <view class="task-list-section">
    <text class="section-title">推荐任务</text>
    <view class="task-card" wx:for="{{tasks}}" wx:key="id">
      <view class="task-card-header">
        <text class="task-title">{{item.title}}</text>
        <text class="task-reward">¥{{item.reward}}</text>
      </view>
      <view class="task-card-body">
        <text class="task-info">地点: {{item.location}}</text>
        <text class="task-info" wx:if="{{item.area}}">作业面积: {{item.area}}</text>
        <text class="task-info" wx:if="{{item.description}}">需求: {{item.description}}</text>
      </view>
      <view class="task-card-footer" wx:if="{{item.tags.length}}">
        <text class="task-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
      </view>
    </view>
  </view>
</view>
