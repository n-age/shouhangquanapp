<!--miniprogram/pages/my-profile/index.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-info-card">
    <image class="avatar" />
    <view class="user-details">
      <text class="nickname">{{user.nickname}}</text>
      <text class="user-id">ID: {{user.id}}</text>
    </view>
  </view>

  <!-- 认证状态 -->
  <view class="auth-section">
    <view class="section-title">我的认证</view>
    <view class="auth-grid">
      <view class="auth-item" wx:for="{{authStatus}}" wx:key="name">
        <text>{{item.name}}</text>
        <text class="auth-status {{item.certified ? 'certified' : 'not-certified'}}">{{item.certified ? '已认证' : '未认证'}}</text>
      </view>
    </view>
  </view>

  <!-- 功能列表 -->
  <view class="menu-list">
    <view class="menu-item" wx:for="{{menuItems}}" wx:key="text">
      <text>{{item.text}}</text>
      <text class="arrow">></text>
    </view>
    <view class="menu-item">
      <text>联系客服</text>
      <text class="arrow">></text>
    </view>
  </view>

</view>
