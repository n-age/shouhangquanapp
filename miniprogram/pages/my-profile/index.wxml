<!--miniprogram/pages/my-profile/index.wxml-->
<view class="container">
  <view class="user-info-card">
    <image class="avatar" />
    <view class="user-details">
      <text class="nickname">{{user.nickname}}</text>
      <text class="user-id">ID: {{user.id}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">我的认证</view>
    <view class="auth-grid">
      <view class="auth-item" wx:for="{{authStatus}}" wx:key="name" bindtap="navigateToAuth" data-type="{{item.type}}">
        <text>{{item.name}}</text>
        <text class="auth-status {{item.certified ? 'certified' : 'not-certified'}}">{{item.certified ? '已认证' : '未认证'}}</text>
      </view>
    </view>
  </view>

  <view class="section">
     <view class="menu-item">
      <text>关于我们</text>
      <text class="arrow">></text>
    </view>
  </view>
</view>
