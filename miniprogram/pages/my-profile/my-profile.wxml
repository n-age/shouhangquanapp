<!-- miniprogram/pages/my-profile/my-profile.wxml -->
<view class="container">
  <!-- Profile Header -->
  <view class="profile-header" bindtap="handleLogin">
    <image class="avatar" src="{{userInfo.avatarUrl || '/static/images/default-avatar.png'}}" mode="aspectFill"></image>
    <view class="info">
      <text class="name">{{userInfo.nickName || '点击登录'}}</text>
      <text class="tag" wx:if="{{userInfo}}">欢迎来到飞手平台</text>
    </view>
    <view class="settings-icon">
      <text class="material-symbols-outlined">settings</text>
    </view>
  </view>

  <!-- Stats Section -->
  <view class="stats-section">
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">优惠券</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">收藏</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">0</text>
      <text class="stat-label">足迹</text>
    </view>
  </view>

  <!-- Menu List -->
  <view class="menu-list">
    <view class="menu-item" bindtap="navigateToPage" data-url="/pages/order-list/order-list">
      <view class="menu-content">
        <text class="material-symbols-outlined icon">receipt_long</text>
        <text class="menu-text">我的订单</text>
      </view>
      <text class="material-symbols-outlined chevron">chevron_right</text>
    </view>

    <view class="menu-item" bindtap="navigateToPage" data-url="/pages/auth-center/auth-center">
      <view class="menu-content">
        <text class="material-symbols-outlined icon">verified_user</text>
        <text class="menu-text">认证中心</text>
      </view>
      <text class="material-symbols-outlined chevron">chevron_right</text>
    </view>

    <view class="menu-item" bindtap="navigateToPage" data-url="/pages/feedback/feedback">
      <view class="menu-content">
        <text class="material-symbols-outlined icon">feedback</text>
        <text class="menu-text">意见反馈</text>
      </view>
      <text class="material-symbols-outlined chevron">chevron_right</text>
    </view>

    <view class="menu-item" bindtap="navigateToPage" data-url="/pages/about-us/about-us">
      <view class="menu-content">
        <text class="material-symbols-outlined icon">info</text>
        <text class="menu-text">关于我们</text>
      </view>
      <text class="material-symbols-outlined chevron">chevron_right</text>
    </view>
  </view>
</view>
