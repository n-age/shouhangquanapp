/* miniprogram/pages/my-profile/my-profile.wxss */
@import "/styles/common.wxss";

page {
  background-color: #101822;
  color: #f0f0f0;
}

.container {
  padding-bottom: 1rem;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 2rem 1rem 1rem;
  gap: 1rem;
}
.avatar {
  width: 5rem;
  height: 5rem;
  border-radius: 9999px;
  border: 2px solid #f0f0f0;
}
.info {
  flex: 1;
}
.name {
  font-size: 1.5rem;
  font-weight: bold;
}
.tag {
  font-size: 0.875rem;
  color: #a0a0a0;
  margin-top: 0.25rem;
}
.settings-icon {
  font-size: 1.5rem;
  color: #d1d5db;
}

.stats-section {
  display: flex;
  justify-content: space-around;
  margin: 1rem;
  padding: 1rem 0;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 0.75rem;
}
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-value {
  font-size: 1.25rem;
  font-weight: bold;
}
.stat-label {
  font-size: 0.875rem;
  color: #a0a0a0;
  margin-top: 0.25rem;
}

.menu-list {
  margin: 1rem;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 0.75rem;
  padding: 0 1rem;
}
.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}
.menu-item:last-child {
  border-bottom: none;
}
.menu-content {
  display: flex;
  align-items: center;
  gap: 1rem;
}
.icon {
  font-size: 1.5rem;
  color: #a0a0a0;
}
.menu-text {
  font-size: 1rem;
}
.chevron {
  color: #a0a0a0;
}
