<!-- miniprogram/pages/news-list/news-list.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <text class="title">无人机资讯</text>
    <view class="notification-icon-container">
      <text class="material-symbols-outlined">notifications</text>
    </view>
  </view>

  <!-- Search Bar -->
  <view class="search-bar-container">
    <view class="search-bar">
      <text class="material-symbols-outlined search-icon">search</text>
      <input class="search-input" placeholder="搜索无人机资讯" />
    </view>
  </view>

  <!-- Filter Chips -->
  <scroll-view class="chips-container" scroll-x="true" show-scrollbar="false">
    <view
      class="chip {{currentCategory === item.id ? 'active' : ''}}"
      wx:for="{{categories}}"
      wx:key="id"
      bindtap="onCategoryTap"
      data-id="{{item.id}}">
      {{item.name}}
    </view>
  </scroll-view>

  <!-- News Card List -->
  <view class="news-list">
    <block wx:for="{{newsList}}" wx:key="_id">
      <view class="news-card" bindtap="goToNewsDetail" data-id="{{item._id}}">
        <view class="card-content">
          <text class="card-title">{{item.title}}</text>
          <text class="card-meta">{{item.source}} • {{item.timeSince}}</text>
        </view>
        <image class="card-image" src="{{item.coverImageUrl}}" mode="aspectFill"></image>
      </view>
    </block>
  </view>

  <!-- Loading or Empty State -->
  <view class="state-container" wx:if="{{isLoading}}">
     <text>加载中...</text>
  </view>
  <view class="state-container" wx:if="{{!isLoading && newsList.length === 0}}">
     <text>该分类下暂无资讯</text>
  </view>

</view>
