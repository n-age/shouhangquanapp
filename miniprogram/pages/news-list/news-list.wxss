/* miniprogram/pages/news-list/news-list.wxss */
@import "/styles/common.wxss";

page {
  background-color: #f6f7f8;
}

.container {
  padding-bottom: 1rem;
}

.header, .search-bar-container, .chips-container {
  background-color: #f6f7f8;
  position: sticky;
  z-index: 10;
}

.header {
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 1rem;
  padding-bottom: 0.5rem;
}

.title {
  font-size: 1.5rem;
  font-weight: bold;
  color: #111827;
}

.notification-icon-container {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 3rem;
  height: 3rem;
  color: #4b5563;
}

.search-bar-container {
  top: 72px; /* Adjust based on header height */
  padding: 0.75rem 1rem;
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: #e5e7eb;
  border-radius: 0.75rem;
  height: 3rem;
  padding: 0 1rem;
}

.search-icon {
  color: #6b7280;
}

.search-input {
  flex: 1;
  height: 100%;
  padding-left: 0.5rem;
  font-size: 1rem;
  color: #111827;
}

.chips-container {
  top: 144px; /* Adjust based on header and search bar height */
  display: flex;
  white-space: nowrap;
  padding: 0.75rem 1rem;
  border-bottom: 1px solid #e5e7eb;
}

.chip {
  display: inline-block;
  padding: 0.5rem 1.25rem;
  margin-right: 0.75rem;
  border-radius: 9999px;
  background-color: #e5e7eb;
  color: #374151;
  font-size: 0.875rem;
  font-weight: 500;
  transition: all 0.2s;
}

.chip.active {
  background-color: #136dec;
  color: #ffffff;
}

.news-list {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.news-card {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 1rem;
  background-color: #ffffff;
  border-radius: 0.75rem;
  padding: 1rem;
  box-shadow: 0 2px 8px rgba(0,0,0,0.05);
}

.card-content {
  flex: 2;
  display: flex;
  flex-direction: column;
}

.card-title {
  font-size: 1rem;
  font-weight: bold;
  color: #111827;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.4;
}

.card-meta {
  margin-top: auto;
  font-size: 0.875rem;
  color: #6b7280;
}

.card-image {
  flex: 1;
  width: 7rem;
  height: 5rem;
  border-radius: 0.5rem;
  background-color: #f3f4f6;
}

.state-container {
  text-align: center;
  padding: 4rem 0;
  color: #9ca3af;
}
