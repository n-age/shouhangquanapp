/* miniprogram/pages/order-list/index.wxss */
.container {
  background-color: #f7f7f7;
  min-height: 100vh;
}

.tabs {
  display: flex;
  background-color: #fff;
  border-bottom: 1rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  color: #1296db;
  border-bottom: 4rpx solid #1296db;
  font-weight: bold;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.order-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.order-type {
  font-size: 30rpx;
  font-weight: bold;
}

.order-status {
  font-size: 28rpx;
  color: #1296db;
}

.order-card-body {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
}

.order-info {
  display: block;
  margin-top: 5rpx;
}

.order-card-footer {
  text-align: right;
}

.order-price {
  font-size: 30rpx;
  font-weight: bold;
  color: #e64340;
}

.empty-state {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
}
