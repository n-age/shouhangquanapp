<!-- miniprogram/pages/order-list/order-list.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">我的订单</text>
  </view>

  <!-- Filter Tabs -->
  <scroll-view class="tabs-container" scroll-x="true" show-scrollbar="false">
    <view
      class="tab {{currentTab === item.status ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="status"
      bindtap="onTabClick"
      data-status="{{item.status}}">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- Order List -->
  <scroll-view class="order-list" scroll-y="true" bindscrolltolower="loadMoreOrders">
    <block wx:if="{{orderList.length > 0}}">
      <view class="order-card" wx:for="{{orderList}}" wx:key="_id" bindtap="goToOrderDetail" data-id="{{item._id}}">
        <view class="card-header">
          <text class="task-title">{{item.taskInfo.title}}</text>
          <text class="status-text status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <view class="card-body">
          <text class="info-text">订单金额: <text class="amount">¥{{item.amount}}</text></text>
          <text class="info-text">下单时间: {{item.formattedCreateDate}}</text>
        </view>
        <view class="card-footer">
          <!-- Action buttons will be added in order-details page -->
          <button class="action-button primary">查看详情</button>
        </view>
      </view>
    </block>

    <!-- Empty State -->
    <view class="empty-state" wx:else>
      <text class="material-symbols-outlined empty-icon">receipt_long</text>
      <text class="empty-text">暂无相关订单</text>
    </view>
  </scroll-view>
</view>
