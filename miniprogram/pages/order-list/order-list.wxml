<!-- miniprogram/pages/order-list/order-list.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">我的订单</text>
  </view>

  <!-- Filter Tabs -->
  <scroll-view class="tabs-container" scroll-x="true" show-scrollbar="false">
    <view
      class="tab {{currentTab === item.status ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="status"
      bindtap="onTabClick"
      data-status="{{item.status}}">
      {{item.label}}
    </view>
  </scroll-view>

  <!-- Order List -->
  <scroll-view class="order-list" scroll-y="true" bindscrolltolower="loadMoreOrders">
    <block wx:if="{{orderList.length > 0}}">
       <block wx:for="{{orderList}}" wx:key="_id">
        <view bindtap="goToOrderDetail" data-id="{{item._id}}">
            <list-card item="{{item}}" type="order" />
        </view>
       </block>
    </block>

    <block wx:if="{{isLoading && orderList.length === 0}}">
        <skeleton-task-card></skeleton-task-card>
        <skeleton-task-card></skeleton-task-card>
    </block>

    <!-- Empty State -->
    <view class="empty-state" wx:if="{{!isLoading && orderList.length === 0}}">
      <text class="material-symbols-outlined empty-icon">receipt_long</text>
      <text class="empty-text">暂无相关订单</text>
    </view>
  </scroll-view>
</view>
