/* miniprogram/pages/order-list/order-list.wxss */
@import "/styles/common.wxss";

page {
  background-color: #101822;
  color: #f0f0f0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  display: flex; align-items: center; padding: 1rem;
  background-color: #101822;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: sticky; top: 0; z-index: 100;
}
.back-button {
  display: flex; align-items: center; justify-content: center;
  width: 2.5rem; height: 2.5rem; margin-left: -0.5rem;
}
.title {
  flex: 1; text-align: center; font-size: 1.125rem;
  font-weight: bold; margin-right: 2.5rem;
}

.tabs-container {
  display: flex;
  white-space: nowrap;
  padding: 0 1rem;
  background-color: #101822;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: sticky; top: 72px; z-index: 100;
}
.tab {
  display: inline-block;
  padding: 0.75rem 0;
  margin-right: 1.5rem;
  color: #a0a0a0;
  font-weight: bold;
  border-bottom: 3px solid transparent;
}
.tab.active {
  color: #136dec;
  border-bottom-color: #136dec;
}

.order-list {
  flex: 1;
  padding: 1rem;
}
.order-card {
  background-color: #18222c;
  border-radius: 0.75rem;
  padding: 1rem;
  margin-bottom: 1rem;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 0.75rem;
}
.task-title {
  font-size: 1.125rem;
  font-weight: bold;
  flex: 1;
  margin-right: 1rem;
}
.status-text {
  font-size: 0.875rem;
  font-weight: 500;
}
.status-pending_payment { color: #FFA500; }
.status-in_progress { color: #136dec; }
.status-completed { color: #2ECC71; }
.status-cancelled { color: #888888; }

.card-body {
  padding: 0.75rem 0;
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}
.info-text {
  font-size: 0.875rem;
  color: #a0a0a0;
}
.amount {
  color: #f0f0f0;
  font-weight: 500;
}

.card-footer {
  display: flex;
  justify-content: flex-end;
  padding-top: 0.75rem;
}
.action-button {
  height: 2.25rem;
  padding: 0 1.25rem;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: bold;
  background-color: rgba(255, 255, 255, 0.1);
  color: #f0f0f0;
}

.empty-state {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding-top: 6rem; text-align: center; color: #a0a0a0;
}
.empty-icon { font-size: 4rem; }
.empty-text { margin-top: 1rem; font-size: 1rem; }
