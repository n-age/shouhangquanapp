/* miniprogram/pages/order-list/order-list.wxss */
page {
  background-color: #f6f7f8;
}

.dark page {
    background-color: #101822;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 16px;
  padding-bottom: 8px;
  background-color: #ffffff;
  border-bottom: 1px solid #e5e7eb;
}

.dark .header {
    background-color: #1a242f;
    border-bottom-color: #374151;
}

.back-button {
  padding-right: 16px;
}

.title {
  font-size: 18px;
  font-weight: bold;
  color: #303133;
}
.dark .title {
    color: #f0f0f0;
}

.tabs-container {
  display: flex;
  background-color: #ffffff;
  padding: 0 16px;
  border-bottom: 1px solid #e5e7eb;
}
.dark .tabs-container {
    background-color: #1a242f;
    border-bottom-color: #374151;
}

.tab {
  padding: 12px 8px;
  margin-right: 24px;
  font-size: 14px;
  color: #606266;
  white-space: nowrap;
  border-bottom: 2px solid transparent;
}
.dark .tab {
    color: #a0a0a0;
}


.tab.active {
  color: #136dec;
  font-weight: bold;
  border-bottom-color: #136dec;
}

.order-list {
  flex: 1;
  padding: 12px 16px 0;
  box-sizing: border-box;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 100px;
  color: #909399;
}
.dark .empty-state {
    color: #a0a0a0;
}


.empty-icon {
  font-size: 60px;
  margin-bottom: 16px;
}

.empty-text {
  font-size: 16px;
}
