<!-- miniprogram/pages/profile-pilot/profile-pilot.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">飞手主页</text>
    <view class="more-button">
      <text class="material-symbols-outlined">more_horiz</text>
    </view>
  </view>

  <!-- Profile Header -->
  <view class="profile-header">
    <image class="avatar" src="{{pilotInfo.avatarUrl}}" mode="aspectFill"></image>
    <view class="info">
      <view class="name-row">
        <text class="name">{{pilotInfo.nickName}}</text>
        <text class="material-symbols-outlined verified-icon">verified</text>
      </view>
      <text class="tag">{{pilotInfo.level || '平台认证飞手'}}</text>
    </view>
    <button class="follow-button">关注</button>
  </view>

  <!-- Profile Stats -->
  <view class="stats-container">
    <view class="stat-item">
      <text class="stat-value">{{pilotInfo.stats.flightHours}}h</text>
      <text class="stat-label">总飞行小时</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{pilotInfo.stats.completedTasks}}</text>
      <text class="stat-label">完成任务</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{pilotInfo.stats.rating}}</text>
      <text class="stat-label">综合评分</text>
    </view>
  </view>

  <!-- Tabs -->
  <view class="tabs">
    <view class="tab active">简介</view>
    <view class="tab">作品集</view>
  </view>

  <!-- Content Sections -->
  <view class="content-sections">
    <!-- About Me -->
    <view class="section">
      <text class="section-title">飞手简介</text>
      <text class="section-text">{{pilotInfo.bio}}</text>
    </view>

    <!-- Expertise -->
    <view class="section">
      <text class="section-title">擅长领域</text>
      <view class="tags-container">
        <block wx:for="{{pilotInfo.skills}}" wx:key="*this">
          <view class="skill-tag">{{item}}</view>
        </block>
      </view>
    </view>

    <!-- Completed Missions -->
    <view class="section">
      <text class="section-title">完成的任务</text>
      <view class="missions-list">
        <!-- Mission Card Example -->
        <view class="mission-card" wx:for="{{pilotInfo.completedMissions}}" wx:key="id">
          <image class="mission-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view class="mission-info">
            <text class="mission-title">{{item.title}}</text>
            <view class="mission-meta">
              <text class="meta-item">{{item.date}}</text>
              <text class="meta-item">{{item.location}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Fixed Bottom Button -->
  <view class="footer">
    <button class="contact-button">
      <text class="material-symbols-outlined">chat</text>
      <text>联系飞手</text>
    </button>
  </view>
</view>
