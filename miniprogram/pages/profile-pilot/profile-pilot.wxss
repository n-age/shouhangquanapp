/* miniprogram/pages/profile-pilot/profile-pilot.wxss */
@import "/styles/common.wxss";

page {
  background-color: #101822;
  color: #f0f0f0;
}

.container {
  padding-bottom: 6rem; /* for footer */
}

.header {
  display: flex;
  align-items: center;
  padding: 1rem;
  background-color: rgba(16, 24, 34, 0.8);
  backdrop-filter: blur(5px);
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
}

.back-button, .more-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 1.125rem;
  font-weight: bold;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 1rem;
  gap: 1rem;
}

.avatar {
  width: 6rem;
  height: 6rem;
  border-radius: 9999px;
  border: 2px solid #f0f0f0;
}

.info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.name {
  font-size: 1.375rem;
  font-weight: bold;
}

.verified-icon {
  color: #136dec;
  font-size: 1.25rem;
}

.tag {
  font-size: 0.875rem;
  color: #a0a0a0;
}

.follow-button {
  height: 2.5rem;
  padding: 0 1.5rem;
  background-color: #136dec;
  color: #ffffff;
  border-radius: 0.5rem;
  font-size: 0.875rem;
  font-weight: bold;
}

.stats-container {
  display: flex;
  justify-content: space-around;
  padding: 0 1rem 1rem;
  gap: 0.75rem;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0.75rem;
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 0.75rem;
}

.stat-value {
  font-size: 1.5rem;
  font-weight: bold;
}

.stat-label {
  font-size: 0.875rem;
  color: #a0a0a0;
}

.tabs {
  display: flex;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  padding: 0 1rem;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 0.75rem 0;
  color: #a0a0a0;
  font-weight: bold;
  border-bottom: 3px solid transparent;
}

.tab.active {
  color: #ffffff;
  border-bottom-color: #136dec;
}

.content-sections {
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.section {
}

.section-title {
  display: block;
  font-size: 1.125rem;
  font-weight: bold;
  margin-bottom: 0.75rem;
}

.section-text {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: #d1d5db;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.skill-tag {
  padding: 0.375rem 0.75rem;
  background-color: rgba(19, 109, 236, 0.2);
  color: #60a5fa;
  border-radius: 9999px;
  font-size: 0.875rem;
}

.missions-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.mission-card {
  background-color: rgba(255, 255, 255, 0.05);
  border-radius: 0.75rem;
  overflow: hidden;
}

.mission-image {
  width: 100%;
  height: 150px;
}

.mission-info {
  padding: 1rem;
}

.mission-title {
  display: block;
  font-weight: bold;
}

.mission-meta {
  display: flex;
  gap: 1rem;
  font-size: 0.875rem;
  color: #a0a0a0;
  margin-top: 0.5rem;
}

.footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 1rem;
  background: rgba(16, 24, 34, 0.8);
  backdrop-filter: blur(5px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.contact-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  width: 100%;
  height: 3rem;
  background-color: #136dec;
  color: #ffffff;
  border-radius: 0.75rem;
  font-size: 1rem;
  font-weight: bold;
}
