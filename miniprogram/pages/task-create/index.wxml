<!--miniprogram/pages/task-create/index.wxml-->
<view class="container">
  <view class="form-card">
    <view class="form-title">发布新任务</view>

    <view class="form-group">
      <text class="form-label">任务标题</text>
      <input class="form-input" placeholder="请输入任务标题" bindinput="handleInput" data-field="title" value="{{formData.title}}"/>
    </view>

    <view class="form-group">
      <text class="form-label">任务描述</text>
      <textarea class="form-textarea" placeholder="请详细描述任务内容、要求等" bindinput="handleInput" data-field="description" value="{{formData.description}}"/>
    </view>

    <view class="form-group">
      <text class="form-label">悬赏金额 (元)</text>
      <input class="form-input" type="digit" placeholder="请输入任务悬赏金额" bindinput="handleInput" data-field="reward" value="{{formData.reward}}"/>
    </view>

    <view class="form-group">
      <text class="form-label">任务地点</text>
      <input class="form-input" placeholder="请输入任务地点" bindinput="handleInput" data-field="address" value="{{formData.address}}"/>
    </view>
  </view>

  <button class="submit-button" type="primary" bindtap="handleSubmit">确认发布</button>
</view>
