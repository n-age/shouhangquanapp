<!-- miniprogram/pages/task-create/task-create.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">发布任务</text>
  </view>

  <form bindsubmit="formSubmit">
    <view class="form-section">
      <view class="section-title">任务信息</view>

      <!-- 任务标题 -->
      <view class="form-group">
        <label class="label">任务标题</label>
        <input name="title" class="input" placeholder="请输入任务标题" />
      </view>

      <!-- 任务描述 -->
      <view class="form-group">
        <label class="label">任务描述</label>
        <textarea name="description" class="textarea" placeholder="请详细描述任务内容、要求、交付成果等..." maxlength="1000"></textarea>
      </view>

       <!-- 任务类型 -->
      <view class="form-group">
        <label class="label">任务类型</label>
        <picker name="category" bindchange="bindCategoryChange" value="{{categoryIndex}}" range="{{categories}}">
          <view class="picker">
            {{categories[categoryIndex] || '请选择任务类型'}}
            <text class="material-symbols-outlined">expand_more</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">时间和地点</view>

      <!-- 任务地点 -->
      <view class="form-group">
        <label class="label">任务地点</label>
        <view class="picker" bindtap="chooseLocation">
            {{location.address || '请选择任务地点'}}
            <text class="material-symbols-outlined">chevron_right</text>
        </view>
      </view>

      <!-- 截止日期 -->
      <view class="form-group">
        <label class="label">截止日期</label>
        <picker name="deadline" mode="date" value="{{deadline}}" start="{{currentDate}}" bindchange="bindDateChange">
           <view class="picker">
            {{deadline || '请选择任务截止日期'}}
            <text class="material-symbols-outlined">expand_more</text>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-section">
      <view class="section-title">预算</view>
      <!-- 任务报酬 -->
      <view class="form-group">
        <label class="label">任务报酬 (元)</label>
        <input name="reward" type="digit" class="input" placeholder="请输入任务报酬金额" />
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="footer">
       <button class="submit-button" form-type="submit">确认发布</button>
    </view>
  </form>
</view>
