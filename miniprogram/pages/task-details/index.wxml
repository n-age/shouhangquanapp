<!--miniprogram/pages/task-details/index.wxml-->
<view class="container">
  <block wx:if="{{task}}">
    <view class="card">
      <view class="card-header">
        <text class="title">{{task.title}}</text>
        <text class="reward">¥{{task.reward}}</text>
      </view>
      <view class="tags">
        <view class="tag-status status-{{task.status}}">{{task.statusText}}</view>
      </view>
    </view>

    <view class="card">
      <view class="card-title">任务信息</view>
      <view class="info-item">
        <text>地点: {{task.address}}</text>
      </view>
      <view class="info-item">
        <text>截止: {{task.deadline}}</text>
      </view>
      <view class="info-item">
        <text>描述: {{task.description}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">发布方</view>
      <view class="publisher-info">
        <text>{{task.publisherInfo.nickName}}</text>
      </view>
    </view>

    <button class="action-button" type="primary">接受任务</button>
  </block>
  <block wx:else>
    <view class="loading-state">加载中...</view>
  </block>
</view>
