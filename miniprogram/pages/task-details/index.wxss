/* miniprogram/pages/task-details/index.wxss */
.container {
  padding: 20rpx;
  background-color: #f7f7f7;
  min-height: 100vh;
}

.card {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.reward {
  font-size: 36rpx;
  color: #e64340;
}

.tags {
  display: flex;
  margin-bottom: 10rpx;
}

.tag-status {
  padding: 5rpx 10rpx;
  border-radius: 5rpx;
  color: #fff;
  font-size: 24rpx;
}

.status-open { background-color: #1296db; }
.status-inprogress { background-color: #ffa500; }
.status-completed { background-color: #4caf50; }
.status-closed { background-color: #999; }

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  padding-bottom: 10rpx;
  border-bottom: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.info-item {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.publisher-info {
  font-size: 28rpx;
}

.action-button {
  margin-top: 20rpx;
}

.loading-state {
  text-align: center;
  margin-top: 100rpx;
  color: #999;
}
