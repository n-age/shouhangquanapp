<!-- miniprogram/pages/task-details/task-details.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <view class="back-button" bindtap="navigateBack">
      <text class="material-symbols-outlined">arrow_back_ios_new</text>
    </view>
    <text class="title">任务详情</text>
  </view>

  <block wx:if="{{!isLoading}}">
    <scroll-view class="content" scroll-y="true">
      <!-- Main Info -->
      <view class="main-info-section">
        <view class="title-reward-row">
          <text class="task-title">{{task.title}}</text>
          <text class="task-reward">¥{{task.reward}}</text>
        </view>
        <view class="tags-row">
          <view class="tag status-{{task.status}}">{{task.statusText}}</view>
          <block wx:for="{{task.tags}}" wx:for-item="tag" wx:key="*this">
            <view class="tag">{{tag}}</view>
          </block>
        </view>
      </view>

      <!-- Details Section -->
      <view class="details-section">
        <view class="detail-item">
          <text class="material-symbols-outlined icon">location_pin</text>
          <text class="detail-text">{{task.address}}</text>
        </view>
        <view class="detail-item">
          <text class="material-symbols-outlined icon">calendar_today</text>
          <text class="detail-text">截止日期: {{task.deadline}}</text>
        </view>
      </view>

      <!-- Description Section -->
      <view class="description-section">
        <text class="section-title">任务描述</text>
        <text class="description-text">{{task.description}}</text>
      </view>

      <!-- Publisher Section -->
      <view class="publisher-section">
        <text class="section-title">发布者信息</text>
        <view class="publisher-card">
          <image class="publisher-avatar" src="{{task.publisherInfo.avatarUrl || '../../static/images/default-avatar.png'}}" mode="aspectFill"></image>
          <view class="publisher-info">
            <text class="publisher-name">{{task.publisherInfo.nickName}}</text>
            <text class="publisher-verified-status">已实名认证</text>
          </view>
          <button class="contact-button">
            <text class="material-symbols-outlined">chat_bubble</text>
            <text>联系</text>
          </button>
        </view>
      </view>
    </scroll-view>

    <!-- Footer Action Button -->
    <view class="footer">
      <button class="action-button" bindtap="acceptTask" disabled="{{task.status !== 'open'}}">
        {{task.status === 'open' ? '立即抢单' : '任务已关闭'}}
      </button>
    </view>
  </block>

  <view class="loading-state" wx:else>
    <text>加载中...</text>
  </view>
</view>
