/* miniprogram/pages/task-details/task-details.wxss */
@import "/styles/common.wxss";

page {
  background-color: #101822;
  color: #f0f0f0;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  display: flex;
  align-items: center;
  padding: 1rem;
  background-color: #101822;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: sticky;
  top: 0;
  z-index: 100;
}
.back-button {
  display: flex; align-items: center; justify-content: center;
  width: 2.5rem; height: 2.5rem; margin-left: -0.5rem;
}
.title {
  flex: 1; text-align: center; font-size: 1.125rem;
  font-weight: bold; margin-right: 2.5rem;
}

.content {
  flex: 1;
  padding: 1.5rem 1rem;
}

.main-info-section {
  margin-bottom: 1.5rem;
}
.title-reward-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 1rem;
}
.task-title {
  font-size: 1.5rem;
  font-weight: 800;
  line-height: 1.3;
}
.task-reward {
  font-size: 1.25rem;
  font-weight: bold;
  color: #136dec;
  white-space: nowrap;
}
.tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-top: 1rem;
}
.tag {
  padding: 0.25rem 0.75rem;
  font-size: 0.75rem;
  font-weight: 500;
  border-radius: 0.25rem;
  background-color: rgba(19, 109, 236, 0.2);
  color: #60a5fa;
}
.tag.status-open {
  background-color: rgba(34, 197, 94, 0.2);
  color: #4ade80;
}

.details-section {
  margin-bottom: 1.5rem;
  padding: 1rem;
  background-color: #182029;
  border-radius: 0.75rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}
.detail-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  color: #d1d5db;
}
.icon { font-size: 1.25rem; color: #9ca3af; }

.description-section, .publisher-section {
  margin-bottom: 1.5rem;
}
.section-title {
  display: block;
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
  color: #e5e7eb;
}
.description-text {
  font-size: 0.9375rem;
  line-height: 1.7;
  color: #9ca3af;
}

.publisher-card {
  display: flex;
  align-items: center;
  background-color: #182029;
  border-radius: 0.75rem;
  padding: 1rem;
  gap: 0.75rem;
}
.publisher-avatar {
  width: 3rem; height: 3rem; border-radius: 9999px;
  background-color: #374151;
}
.publisher-info {
  flex: 1; display: flex; flex-direction: column;
}
.publisher-name { font-weight: 600; }
.publisher-verified-status {
  font-size: 0.75rem; color: #4ade80;
}
.contact-button {
  display: flex; align-items: center; justify-content: center;
  gap: 0.25rem; height: 2.25rem; padding: 0 1rem;
  background-color: #374151; color: #e5e7eb;
  border-radius: 0.5rem; font-size: 0.875rem;
}
.contact-button .material-symbols-outlined { font-size: 1rem; }

.footer {
  position: sticky; bottom: 0; padding: 1rem;
  background-color: rgba(16, 24, 34, 0.8);
  backdrop-filter: blur(5px);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
}
.action-button {
  width: 100%; height: 3.5rem; border-radius: 0.75rem;
  background-color: #136dec; color: #ffffff;
  font-size: 1.125rem; font-weight: bold;
}
.action-button[disabled] {
  background-color: #374151; color: #9ca3af;
}

.loading-state {
  text-align: center; padding: 4rem 0; color: #9ca3af;
}
