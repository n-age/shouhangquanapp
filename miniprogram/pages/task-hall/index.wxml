<!--miniprogram/pages/task-hall/index.wxml-->
<view class="container">
  <!-- 筛选/排序栏 -->
  <view class="filter-bar">
    <view class="filter-option active">综合排序</view>
    <view class="filter-option">最新发布</view>
    <view class="filter-option">价格最高</view>
    <view class="filter-option">筛选</view>
  </view>

  <!-- 任务列表 -->
  <view class="task-list">
    <block wx:if="{{ taskList.length > 0 }}">
      <view class="task-card" wx:for="{{taskList}}" wx:key="id" bindtap="handleCardTap" data-id="{{item.id}}">
        <view class="task-card-header">
          <text class="task-title">{{item.title}}</text>
          <text class="task-reward">¥{{item.reward}}</text>
        </view>
        <view class="task-card-body">
          <text class="task-info">地点: {{item.location}}</text>
          <text class="task-info">类型: {{item.type}}</text>
        </view>
        <view class="task-card-footer" wx:if="{{item.tags && item.tags.length}}">
            <text class="task-tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this">{{tag}}</text>
        </view>
      </view>
    </block>
    <block wx:else>
      <view class="empty-state">
        <text>暂无任务</text>
      </view>
    </block>
  </view>
</view>
