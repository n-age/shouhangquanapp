/* miniprogram/pages/task-hall/index.wxss */
.container {
  background-color: #f7f7f7;
  min-height: 100vh;
}

.filter-bar {
  display: flex;
  justify-content: space-around;
  background-color: #fff;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eee;
  font-size: 28rpx;
}

.filter-option {
  color: #666;
}

.filter-option.active {
  color: #1296db;
  font-weight: bold;
}

.task-list {
  padding: 20rpx;
}

.task-card {
  background-color: #fff;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.task-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.task-title {
  font-size: 32rpx;
  font-weight: bold;
}

.task-reward {
  font-size: 32rpx;
  color: #e64340;
}

.task-card-body {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.task-info {
  display: block;
  margin-top: 5rpx;
}

.task-card-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.task-tag {
  background-color: #eee;
  color: #666;
  font-size: 22rpx;
  padding: 5rpx 10rpx;
  border-radius: 5rpx;
}

.task-tag.urgent {
  background-color: #e64340;
  color: #fff;
}

.task-tag.certified {
  background-color: #1296db;
  color: #fff;
}
