<!-- miniprogram/pages/task-hall/task-hall.wxml -->
<view class="container">
  <!-- Top App Bar -->
  <view class="header">
    <text class="title">任务大厅</text>
    <view class="profile-icon-container" bindtap="goToMyProfile">
      <text class="material-symbols-outlined">account_circle</text>
    </view>
  </view>

  <!-- Search & Filters -->
  <view class="filters-container">
    <!-- Search Bar -->
    <view class="search-bar">
      <text class="material-symbols-outlined search-icon">search</text>
      <input class="search-input" placeholder="搜索任务标题/地点" bindinput="onSearchInput" />
    </view>
    <!-- Filter Chips -->
    <view class="chips-row">
      <view class="chip" bindtap="onFilterTap" data-type="status">状态<text class="material-symbols-outlined">expand_more</text></view>
      <view class="chip" bindtap="onFilterTap" data-type="category">类型<text class="material-symbols-outlined">expand_more</text></view>
      <view class="chip" bindtap="onFilterTap" data-type="location">地点<text class="material-symbols-outlined">expand_more</text></view>
      <view class="chip" bindtap="onFilterTap" data-type="sort">排序<text class="material-symbols-outlined">expand_more</text></view>
    </view>
  </view>

  <!-- Task List -->
  <scroll-view class="task-list" scroll-y="true" bindscrolltolower="loadMoreTasks">
    <block wx:for="{{taskList}}" wx:key="_id">
      <list-card item="{{item}}" bind:cardtap="goToTaskDetail" />
    </block>
    <!-- Skeleton UI -->
    <block wx:if="{{isLoading && taskList.length === 0}}">
      <skeleton-task-card></skeleton-task-card>
      <skeleton-task-card></skeleton-task-card>
      <skeleton-task-card></skeleton-task-card>
    </block>

    <view class="loading-state" wx:if="{{isLoading && taskList.length > 0}}">正在加载更多...</view>
    <view class="loading-state" wx:if="{{!hasMore && taskList.length > 0}}">没有更多任务了</view>
  </scroll-view>

  <!-- Floating Action Button -->
  <view class="fab-container" bindtap="goToCreateTask">
    <text class="material-symbols-outlined">add</text>
    <text class="fab-text">发布任务</text>
  </view>
</view>
