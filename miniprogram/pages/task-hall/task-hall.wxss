/* miniprogram/pages/task-hall/task-hall.wxss */
page {
  background-color: #f6f7f8;
}

.dark page {
    background-color: #101822;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px;
  padding-bottom: 8px;
  background-color: #f6f7f8;
}

.dark .header {
    background-color: #101822;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #303133;
}
.dark .title {
    color: #f0f0f0;
}


.profile-icon-container {
  padding: 8px;
}

.profile-icon-container .material-symbols-outlined {
  font-size: 28px;
  color: #606266;
}
.dark .profile-icon-container .material-symbols-outlined {
    color: #a0a0a0;
}


.filters-container {
  padding: 0 16px 12px;
  background-color: #f6f7f8;
}
.dark .filters-container {
    background-color: #101822;
}


.search-bar {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 8px;
  padding: 0 12px;
  margin-bottom: 12px;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}
.dark .search-bar {
    background-color: #1a242f;
}

.search-icon {
  font-size: 20px;
  color: #909399;
}
.dark .search-icon {
    color: #a0a0a0;
}

.search-input {
  flex: 1;
  height: 44px;
  border: none;
  padding: 0 8px;
  font-size: 14px;
}

.chips-row {
  display: flex;
  gap: 8px;
  overflow-x: auto;
}

.chip {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  padding: 6px 12px;
  border-radius: 999px;
  font-size: 13px;
  color: #606266;
  white-space: nowrap;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}
.dark .chip {
    background-color: #1a242f;
    color: #f0f0f0;
}


.chip .material-symbols-outlined {
  font-size: 16px;
  margin-left: 4px;
}

.task-list {
  flex: 1;
  padding: 0 16px;
  box-sizing: border-box;
}

.loading-state {
  text-align: center;
  color: #909399;
  padding: 16px;
  font-size: 14px;
}
.dark .loading-state {
    color: #a0a0a0;
}

.fab-container {
  position: fixed;
  bottom: 30px;
  right: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #136dec;
  color: white;
  border-radius: 999px;
  height: 56px;
  padding: 0 24px;
  box-shadow: 0 4px 12px rgba(19, 109, 236, 0.4);
}

.fab-container .material-symbols-outlined {
  font-size: 24px;
  margin-right: 8px;
}

.fab-text {
  font-size: 16px;
  font-weight: bold;
}
